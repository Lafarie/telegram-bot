# This file serves as a template for environment variables needed for the project.
# It includes placeholders for sensitive information like API keys and bot tokens.

BOT_TOKEN=your_telegram_bot_token_here
API_KEY=
ADMIN_CHAT_ID=your_admin_chat_id_here
# Bot owner has full access to all commands
BOT_OWNER=123456789
# Comma-separated list of user IDs who are authorized to use the bot
AUTHORIZED_USERS=123456789,987654321,112233445
# Set to true to allow anyone to use the bot (disables authorization checks)
ALLOW_ANYONE=false
DATABASE_URL=your_database_url_here
REDIS_URL=your_redis_url_here
TELEGRAM_API_URL=https://api.telegram.org/bot${BOT_TOKEN}/
LOG_LEVEL=info
MEDIA_STORAGE_PATH=./media_storage/

# OpenAI-compatible AI settings
AI_BASE_URL=http://127.0.0.1:8045/v1
AI_API_KEY=sk-your-api-key
AI_MODEL=gemini-3-flash
AI_FALLBACK_MODEL=claude-sonnet-4-5
AI_IMAGE_MODEL=gemini-3.1-flash-image
AI_PROVIDER=openai-compatible
AI_MAX_TOKENS=1024
AI_TIMEOUT_MS=90000
AI_RETRY_ON_TIMEOUT=true
AI_RETRY_TIMEOUT_MS=120000

# Claude (Anthropic native API) example
# AI_PROVIDER=anthropic
# AI_BASE_URL=https://api.anthropic.com/v1
# AI_API_KEY=sk-ant-your-anthropic-key
# AI_MODEL=claude-3-5-sonnet-latest

# Google Sheet analytics source (must be shareable/readable)
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/1Jvt538VC7Mq7Bb1BLE6VcoA7TuAzbvJU7vOejpV5aAE/edit?gid=0#gid=0
GOOGLE_SHEET_MAX_ROWS=120
GOOGLE_SHEET_MAX_COLUMNS=20
GOOGLE_SHEET_TIMEOUT_MS=15000

# AI iterative data-check loop for private chat
AI_DATA_LOOP_MAX_TURNS=3