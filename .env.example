# This file serves as a template for environment variables needed for the project.
# It includes placeholders for sensitive information like API keys and bot tokens.

BOT_TOKEN=your_admin_chat_id_here
API_KEY=
ADMIN_CHAT_ID=your_admin_chat_id_here
# Bot owner has full access to all commands
BOT_OWNER=123456789
# Comma-separated list of user IDs who are authorized to use the bot
AUTHORIZED_USERS=123456789,987654321,112233445
DATABASE_URL=your_database_url_here
REDIS_URL=your_redis_url_here
TELEGRAM_API_URL=https://api.telegram.org/bot${BOT_TOKEN}/
LOG_LEVEL=info
MEDIA_STORAGE_PATH=./media_storage/

# OpenAI-compatible AI API settings
AI_BASE_URL=http://127.0.0.1:8045/v1
AI_API_KEY=sk-your-api-key
AI_MODEL=gemini-3-flash
AI_TIMEOUT_MS=30000